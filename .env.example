# Server-only configuration. Never prefix these secrets with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Optional pinned free-model overrides. Leave blank to use the probed defaults in lib/env.ts
# (dots-studio/dots-3-note-preview:free, Ask on nvidia/nemotron-3.5-super-vl:free, fallbacks
# dots-studio/dots-3-note-preview:free, nvidia/nemotron-3.5-super-vl:free and google/gemma-4-31b-it:free).
AI_MODEL_LOCKED_IN=
AI_MODEL_SUMMARY=
AI_MODEL_ASK=
AI_MODEL_JSON=
AI_MODEL_VISION=
AI_MODEL_FALLBACKS=
# Neon direct/unpooled URL is required for schema pushes.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# At least 32 characters; keep this server-only and unique per deployment.
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=
# Password reset email (Resend). Leave empty to disable sending.
RESEND_API_KEY=
EMAIL_FROM=
# Optional birthday greeting: <userId>=MM-DD, comma-separated. Set real values only in the host's env.
BIRTHDAY_DATES=
